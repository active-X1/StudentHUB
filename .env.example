# Placeholders only. Copy to .env for local development. NEVER commit a real .env file.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Time zone used for daily rules such as the admin lockout reset (IANA name).
SERVER_TIMEZONE=UTC

# Number of reverse-proxy hops to trust for client IPs (0 = none). Set to 1 behind a single proxy/load balancer.
TRUST_PROXY=0

# Serve the admin sign-in page and dashboard at /admin (default true). Set false to hide every admin UI path.
# Admin data is protected by server-side authorization either way.
# ADMIN_UI_ENABLED=true

# PostgreSQL 13+ (required in production)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/student_hub
DB_POOL_MAX=10
# false | true (verify certificate) | no-verify (encrypted, certificate not verified; avoid in production)
DB_SSL=false

# Signs OAuth state, derives CSRF tokens and keys login-attempt hashes. REQUIRED in production, 32+ random characters:
#   openssl rand -base64 48
SESSION_SECRET=

# Restrict sign-up (password and OAuth) to institution addresses, comma-separated. Empty = anyone. Recommended in production.
# ALLOWED_EMAIL_DOMAINS=uni.example.edu

# OAuth (set each pair together; register APP_BASE_URL/api/v1/auth/<provider>/callback with the provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# First administrator, used ONLY by `npm run admin:bootstrap`. Prefer piping the password instead:
#   printf '%s' "$PW" | npm run admin:bootstrap -- --password-stdin
# Remove ADMIN_BOOTSTRAP_PASSWORD from the environment once the admin exists.
ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Phase 4 (not used yet) — object storage for uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
